# Основные настройки
font=JetBrainsMono Nerd Font 9
width=320
height=90
margin=12
padding=10
border-size=2
border-radius=12
default-timeout=5000

# Цветовая схема Dracula (с лёгкой прозрачностью)
background-color=#282a36ee
text-color=#f8f8f2
border-color=#bd93f9

# Поведение
max-visible=5
layer=overlay
anchor=top-right
group-by=app-name
actions=1

# Действия мышью
on-button-left=dismiss
on-button-right=invoke-default-action
on-touch=dismiss

# Настройки для разных типов уведомлений
[urgency=low]
background-color=#44475a
border-color=#6272a4
default-timeout=3000

[urgency=high]
background-color=#ff5555
border-color=#ffb86c
default-timeout=0
