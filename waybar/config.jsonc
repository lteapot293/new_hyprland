{
    "layer": "top",
    "position": "top",
    "height": 44,
    "spacing": 8,
    "output": ["eDP-1"],
    
    "modules-left": ["hyprland/workspaces", "hyprland/window"],
    "modules-center": ["clock"],
    "modules-right": [
        "tray",
        "group/hardware"
    ],
    
    // ===== ГРУППА HARDWARE =====
    "group/hardware": {
        "orientation": "horizontal",
        "modules": [
            "custom/language",
            "backlight",
            "pulseaudio",
            "battery",
            "custom/power"
        ]
    },
    
    // ===== РАБОЧИЕ СТОЛЫ =====
    "hyprland/workspaces": {
        "format": "{icon}",
        "on-click": "activate",
        "active-only": false,
        "all-outputs": true,
        "format-icons": {
            "1": "⦁",
            "2": "⦁",
            "3": "⦁",
            "4": "⦁",
            "5": "⦁",
            "6": "⦁",
            "7": "⦁",
            "8": "⦁",
            "urgent": "⦿",
            "active": "●",
            "default": "○"
        },
        "persistent_workspaces": {
            "*": 3
        },
        "on-scroll-up": "hyprctl dispatch workspace e+1",
        "on-scroll-down": "hyprctl dispatch workspace e-1"
    },
    
    // ===== АКТИВНОЕ ОКНО =====
    "hyprland/window": {
        "format": "{}",
        "max-length": 50,
        "rewrite": {
            "(.*) - Brave": "Brave",
            "(.*) - Chromium": "Chrome",
            "(.*) - Firefox": "Firefox"
        }
    },
    
    // ===== ЧАСЫ =====
"clock": {
    "format": "{:%H:%M %d/%m/%y}",
    "format-alt": "{:%H:%M}",
    "tooltip": true,
    "tooltip-format": "{:%Y-%m-%d %H:%M}",
    "calendar": {
        "mode": "month"
    },
    "on-click-right": "gnome-calendar",
    "locale": "ru_RU.UTF-8"
},
    
    // ===== ТРЕЙ =====
    "tray": {
        "icon-size": 16,
        "spacing": 5,
        "show-passive-items": true
    },
    
    // ===== ЯРКОСТЬ =====
"backlight": {
    "format": "{icon}",
    "format-icons": ["󰃞", "󰃟", "󰃠"],
    "interval": 1, 
    "tooltip-format": "Яркость: {percent}%",
    "on-scroll-up": "brightnessctl set 5%+",
    "on-scroll-down": "brightnessctl set 5%-",
    "on-click": "brightnessctl set 10%+",
    "on-click-right": "brightnessctl set 10%-"
},
    // ===== ЗВУК =====
    "pulseaudio": {
        "format": "{icon}",
        "format-muted": "󰝟",
        "format-icons": {
            "headphone": "",
            "default": ["", "", " "]
        },
        "tooltip-format": "{desc}: {volume}%",
    	"on-scroll-up": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+",
    	"on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-",
    	"on-click": "pavucontrol",
    	"on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "scroll-step": 5
    }, 
    
    // ===== БАТАРЕЯ =====
    "battery": {
        "format": "{icon}",
        "format-charging": "󰂄",
        "format-plugged": "󱘖",
        "format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
        "tooltip-format": "Батарея: {capacity}%",
        "interval": 30,
        "states": {
            "warning": 20,
            "critical": 10
        }
    },
    
    // ===== РАСКЛАДКА =====
"custom/language": {
    "format": "{}",
    "exec": "hyprctl devices -j | jq -r '.keyboards[] | select(.main == true) | .active_keymap' | cut -c1-2 | tr '[:lower:]' '[:upper:]'",
    "interval": 1,
    "on-click": "hyprctl switchxkblayout current next",
    "tooltip": false
},

"custom/power": {
    "format": "󰐥",
    "tooltip": false,
    "menu": "on-click",
    "menu-file": "~/.config/waybar/power_menu.xml",
    "menu-actions": {
        "shutdown": "systemctl poweroff",
        "reboot": "systemctl reboot",
        "suspend": "systemctl suspend",
        "lock": "hyprlock",
        "logout": "hyprctl dispatch exit"
    }
},
    
    // ===== УВЕДОМЛЕНИЯ =====
    "custom/notification": {
        "format": "{icon}",
        "format-icons": {
            "notification": "󰂚",
            "none": "󰂛",
            "dnd-notification": "󰂛",
            "dnd-none": "󰂛",
            "inhibited-notification": "󰂛",
            "inhibited-none": "󰂛"
        },
        "tooltip": false,
        "exec-if": "which swaync-client",
        "exec": "swaync-client -swb",
        "on-click": "swaync-client -t -sw",
        "on-click-right": "swaync-client -d -sw",
        "return-type": "json"
    }
}
